// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "https://github.com/smartcontractkit/chainlink/contracts/src/v0.8/interfaces/VRFCoordinatorV2Interface.sol";
import "https://github.com/smartcontractkit/chainlink/contracts/src/v0.8/VRFConsumerBaseV2.sol";

contract LootBox is VRFConsumerBaseV2 {
    // Mapping of user to their loot box balance
    mapping(address => uint256) public userLootBoxBalance;

    // Mapping of rarity tiers to their corresponding weights
    mapping(uint256 => uint256) public rarityTiers;

    // Chainlink VRF variables
    VRFCoordinatorV2Interface public vrfCoordinator;
    bytes32 public keyHash;
    uint64 public subId;

    // Event emitted when a user opens a loot box
    event LootBoxOpened(address indexed user, uint256 indexed rarity);

    // Event emitted when a user purchases a loot box
    event LootBoxPurchased(address indexed user);

    // Event emitted when the contract is initialized
    event Initialized(address indexed owner);

    // Custom error for unauthorized access
    error Unauthorized(address caller, bytes32 role);

    // Custom error for insufficient funds
    error InsufficientFunds(address caller, uint256 amount);

    /**
     * @notice Initializes the contract with the Chainlink VRF coordinator and key hash
     * @param _vrfCoordinator The address of the Chainlink VRF coordinator
     * @param _keyHash The key hash of the Chainlink VRF
     * @param _subId The subscription ID of the Chainlink VRF
     */
    constructor(
        address _vrfCoordinator,
        bytes32 _keyHash,
        uint64 _subId
    ) VRFConsumerBaseV2(_vrfCoordinator) {
        vrfCoordinator = VRFCoordinatorV2Interface(_vrfCoordinator);
        keyHash = _keyHash;
        subId = _subId;

        // Initialize rarity tiers with weights
        rarityTiers[1] = 100; // Common
        rarityTiers[2] = 50; // Uncommon
        rarityTiers[3] = 20; // Rare
        rarityTiers[4] = 10; // Epic
        rarityTiers[5] = 5; // Legendary

        emit Initialized(msg.sender);
    }

    /**
     * @notice Purchases a loot box for the user
     */
    function purchaseLootBox() public {
        // Check if the user has sufficient funds
        if (msg.value < 1 ether) {
            revert InsufficientFunds(msg.sender, msg.value);
        }

        // Increment the user's loot box balance
        userLootBoxBalance[msg.sender]++;

        emit LootBoxPurchased(msg.sender);
    }

    /**
     * @notice Opens a loot box for the user
     */
    function openLootBox() public {
        // Check if the user has a loot box to open
        if (userLootBoxBalance[msg.sender] == 0) {
            revert InsufficientFunds(msg.sender, userLootBoxBalance[msg.sender]);
        }

        // Decrement the user's loot box balance
        userLootBoxBalance[msg.sender]--;

        // Request a random number from Chainlink VRF
        uint256 requestId = vrfCoordinator.requestRandomness(
            subId,
            keyHash,
            300000
        );

        // Wait for the random number to be fulfilled
        uint256 randomness = awaitRandomness(requestId);

        // Calculate the rarity tier based on the random number
        uint256 rarity = calculateRarity(randomness);

        emit LootBoxOpened(msg.sender, rarity);
    }

    /**
     * @notice Calculates the rarity tier based on the random number
     * @param _randomness The random number generated by Chainlink VRF
     * @return The rarity tier
     */
    function calculateRarity(uint256 _randomness) internal view returns (uint256) {
        // Calculate the cumulative weight of the rarity tiers
        uint256 cumulativeWeight = 0;
        for (uint256 i = 1; i <= 5; i++) {
            cumulativeWeight += rarityTiers[i];
        }

        // Calculate the rarity tier based on the random number
        uint256 rarity = 1;
        uint256 target = _randomness % cumulativeWeight;
        uint256 cumulativeTarget = 0;
        for (uint256 i = 1; i <= 5; i++) {
            cumulativeTarget += rarityTiers[i];
            if (target < cumulativeTarget) {
                rarity = i;
                break;
            }
        }

        return rarity;
    }

    /**
     * @notice Waits for the random number to be fulfilled
     * @param _requestId The request ID of the random number
     * @return The random number
     */
    function awaitRandomness(uint256 _requestId) internal returns (uint256) {
        // Wait for the random number to be fulfilled
        while (vrfCoordinator.getRequestStatus(_requestId) != VRFCoordinatorV2Interface.RequestStatus.FULFILLED) {
            // Do nothing
        }

        // Get the random number
        uint256 randomness = vrfCoordinator.getRequestRandomness(_requestId);

        return randomness;
    }

    /**
     * @notice Gets the user's loot box balance
     * @param _user The address of the user
     * @return The user's loot box balance
     */
    function getLootBoxBalance(address _user) public view returns (uint256) {
        return userLootBoxBalance[_user];
    }

    /**
     * @notice Gets the rarity tiers
     * @return The rarity tiers
     */
    function getRarityTiers() public view returns (mapping(uint256 => uint256) memory) {
        return rarityTiers;
    }
}

contract LootBoxInvariants is Test {
    LootBox public lootBox;

    function setUp() public {
        lootBox = new LootBox(
            0x2Ca8E0C643bDe4C2E2c448Dc0b3f105733380550,
            0x79d3d8832d904592c0bf9818b621522c988bb8b0c05cdc3b15ea1b6b8aa8c951,
            1234
        );
    }

    function invariant_userLootBoxBalance() public {
        assertGt(lootBox.getLootBoxBalance(address(this)), 0);
    }

    function testFuzz_openLootBox(uint256 _randomness) public {
        _randomness = bound(_randomness, 1, type(uint256).max);
        uint256 requestId = lootBox.vrfCoordinator.requestRandomness(
            lootBox.subId,
            lootBox.keyHash,
            300000
        );
        uint256 randomness = lootBox.awaitRandomness(requestId);
        uint256 rarity = lootBox.calculateRarity(randomness);
        assertGt(rarity, 0);
        assertLt(rarity, 6);
    }
}

