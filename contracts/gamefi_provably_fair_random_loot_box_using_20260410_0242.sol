// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "@chainlink/contracts/src/v0.8/interfaces/VRFCoordinatorV2Interface.sol";
import "@chainlink/contracts/src/v0.8/VRFConsumerBaseV2.sol";

contract LootBox is VRFConsumerBaseV2 {
    // Define the rarity tiers and their corresponding weights
    enum Rarity { COMMON, UNCOMMON, RARE, LEGENDARY }
    mapping(Rarity => uint256) public rarityWeights;
    mapping(Rarity => uint256) public rarityCounts;

    // Chainlink VRF variables
    VRFCoordinatorV2Interface public vrfCoordinator;
    bytes32 public keyHash;
    uint64 public subId;

    // Reentrancy guard using EIP-1153 transient storage
    uint256 private constant REENTRANCY_SLOT = uint256(keccak256("aetheris.lootbox.reentrancy"));

    // Event emitted when a new loot box is opened
    event NewLootBox(address indexed opener, Rarity rarity);

    /**
     * @notice Initializes the contract with the Chainlink VRF coordinator and subscription ID
     * @param _vrfCoordinator The address of the Chainlink VRF coordinator
     * @param _keyHash The key hash for the Chainlink VRF
     * @param _subId The subscription ID for the Chainlink VRF
     */
    constructor(
        address _vrfCoordinator,
        bytes32 _keyHash,
        uint64 _subId
    ) VRFConsumerBaseV2(_vrfCoordinator) {
        vrfCoordinator = VRFCoordinatorV2Interface(_vrfCoordinator);
        keyHash = _keyHash;
        subId = _subId;

        // Initialize the rarity weights
        rarityWeights[Rarity.COMMON] = 50;
        rarityWeights[Rarity.UNCOMMON] = 30;
        rarityWeights[Rarity.RARE] = 15;
        rarityWeights[Rarity.LEGENDARY] = 5;
    }

    /**
     * @notice Opens a new loot box using the Chainlink VRF
     */
    function openLootBox() public {
        // Check for reentrancy
        assembly {
            tstore(REENTRANCY_SLOT, 1) // TSTORE: write to transient storage (cleared after tx)
        }

        // Request a random number from the Chainlink VRF
        vrfCoordinator.requestRandomness(
            subId,
            keyHash,
            300000 // Request timeout in seconds
        );

        // Wait for the random number to be fulfilled
        // This will be done in the fulfillRandomness function
    }

    /**
     * @notice Fulfills the random number request from the Chainlink VRF
     * @param requestId The request ID for the random number
     * @param randomness The random number generated by the Chainlink VRF
     */
    function fulfillRandomness(bytes32 requestId, uint256 randomness) internal override {
        // Check for reentrancy
        assembly {
            let reentrancyGuard := tload(REENTRANCY_SLOT) // TLOAD: read transient storage
            if eq(reentrancyGuard, 1) {
                revert("Reentrancy detected") // REVERT: reentrancy detected
            }
        }

        // Determine the rarity of the loot box based on the random number
        uint256 totalWeight = 0;
        for (uint256 i = 0; i < 4; i++) {
            totalWeight += rarityWeights[Rarity(i)];
        }
        uint256 randomRarity = randomness % totalWeight;

        Rarity rarity;
        uint256 cumulativeWeight = 0;
        for (uint256 i = 0; i < 4; i++) {
            cumulativeWeight += rarityWeights[Rarity(i)];
            if (randomRarity < cumulativeWeight) {
                rarity = Rarity(i);
                break;
            }
        }

        // Update the rarity count
        assembly {
            let packed := sload(0) // SLOAD: load the packed storage slot
            let lowValue := and(packed, 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF) // AND: extract the low 128 bits
            let highValue := shr(128, packed) // SHR: extract the high 128 bits

            // Update the rarity count
            if eq(rarity, 0) {
                lowValue := add(lowValue, 1) // ADD: increment the common count
            } else if eq(rarity, 1) {
                highValue := add(highValue, 1) // ADD: increment the uncommon count
            } else if eq(rarity, 2) {
                highValue := add(highValue, 1 << 64) // ADD: increment the rare count
            } else if eq(rarity, 3) {
                highValue := add(highValue, 1 << 128) // ADD: increment the legendary count
            }

            // Pack the updated values
            packed := or(shl(128, highValue), and(lowValue, 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF)) // OR: pack the high and low values
            sstore(0, packed) // SSTORE: store the packed value
        }

        // Emit the NewLootBox event
        emit NewLootBox(msg.sender, rarity);

        // Clear the reentrancy guard
        assembly {
            tstore(REENTRANCY_SLOT, 0) // TSTORE: clear the reentrancy guard
        }
    }

    /**
     * @notice Gets the rarity count
     * @return The rarity count
     */
    function getRarityCount() public view returns (uint256[4] memory) {
        uint256[4] memory counts;
        assembly {
            let packed := sload(0) // SLOAD: load the packed storage slot
            let lowValue := and(packed, 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF) // AND: extract the low 128 bits
            let highValue := shr(128, packed) // SHR: extract the high 128 bits

            // Extract the rarity counts
            counts[0] := and(lowValue, 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF) // AND: extract the common count
            counts[1] := shr(64, highValue) // SHR: extract the uncommon count
            counts[2] := shr(128, highValue) // SHR: extract the rare count
            counts[3] := shr(192, highValue) // SHR: extract the legendary count
        }
        return counts;
    }
}

contract LootBoxInvariants is Test {
    LootBox public lootBox;

    function setUp() public {
        lootBox = new LootBox(address(0), bytes32(0), 0);
    }

    function invariant_rarityWeights() public {
        assertEq(lootBox.rarityWeights(LootBox.Rarity.COMMON), 50);
        assertEq(lootBox.rarityWeights(LootBox.Rarity.UNCOMMON), 30);
        assertEq(lootBox.rarityWeights(LootBox.Rarity.RARE), 15);
        assertEq(lootBox.rarityWeights(LootBox.Rarity.LEGENDARY), 5);
    }

    function testFuzz_openLootBox(uint256 randomness) public {
        randomness = bound(randomness, 0, type(uint256).max);
        lootBox.openLootBox();
        // Simulate the fulfillRandomness function
        lootBox.fulfillRandomness(bytes32(0), randomness);
        assertEq(lootBox.getRarityCount()[0], 1);
    }
}

